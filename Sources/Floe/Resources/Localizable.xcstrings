{
  "sourceLanguage" : "en",
  "strings" : {
    "%@" : {
      "shouldTranslate" : false
    },
    "%@ (code %d)" : {
      "comment" : "The first placeholder is what a failed command printed, the second its exit code.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ (code %2$d)"
          }
        }
      }
    },
    "%@ (default)" : {
      "comment" : "A row in the Open With menu. The placeholder is the name of the app that opens this kind of file by default.\nThe placeholder is the name of a browser."
    },
    "%@ (not installed)" : {
      "comment" : "The placeholder is the name of a command line tool such as claude.\nThe placeholder is the name of an app."
    },
    "%@ Preferences" : {
      "comment" : "The placeholder is a command's name."
    },
    "%@ and %@" : {
      "comment" : "Two counts joined, such as 3 files and 5 tabs.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ and %2$@"
          }
        }
      }
    },
    "%@ can check for updates automatically. You can also check manually from the menu bar or Settings › About." : {
      "comment" : "The placeholder is the name of this app."
    },
    "%@ couldn’t load the release notes." : {
      "comment" : "The placeholder is the name of this app."
    },
    "%@ did not answer" : {
      "comment" : "The placeholder is the name of a music app, Spotify or Music."
    },
    "%@ failed" : {
      "comment" : "The placeholder is the name of a command."
    },
    "%@ failed. Open it in Shortcuts to see why." : {
      "comment" : "The placeholder is the name of a shortcut, and Shortcuts is the app."
    },
    "%@ failed: %@" : {
      "comment" : "The first placeholder is the name of a script, the second is the reason.\nThe first placeholder is the name of a shortcut and the second is what the Shortcuts tool said.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ failed: %2$@"
          }
        }
      }
    },
    "%@ is a launcher for your apps and commands. It runs Raycast extensions and searches your menu bar." : {
      "comment" : "The placeholder is the name of this app."
    },
    "%@ is a sibling of Thaw, built by the same people in the same organization. It shares Thaw’s design system and much of its design." : {
      "comment" : "The placeholder is the name of this app."
    },
    "%@ is chosen, which is not on this Mac. While the switch below is on, Floe refuses to ask it, so no question is sent." : {
      "comment" : "The placeholder is the address of a server."
    },
    "%@ is no longer in the Trash" : {
      "comment" : "The placeholder is a file name."
    },
    "%@ is no longer where Floe wrote it" : {
      "comment" : "The placeholder is the name of a note's file."
    },
    "%@ is still running, so it was not restarted" : {
      "comment" : "The placeholder is an app's name."
    },
    "%@ isn't installed" : {
      "comment" : "The placeholder is the name of an app."
    },
    "%@ isn't installed. Opened in %@" : {
      "comment" : "Both placeholders are names of browsers.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ isn't installed. Opened in %2$@"
          }
        }
      }
    },
    "%@ isn't installed. Opened in the default browser" : {
      "comment" : "The placeholder is the name of a browser."
    },
    "%@ isn't responding" : {
      "comment" : "The placeholder is the name of a command."
    },
    "%@ isn't supported yet" : {
      "comment" : "The placeholder is the name of a kind of view, such as Grid."
    },
    "%@ left" : {
      "comment" : "Beside a running timer. The placeholder is the time left on its clock, such as 4:12."
    },
    "%@ needs these before it can run. Change them later in Floe Settings." : {
      "comment" : "The placeholder is the name of an extension or one of its commands."
    },
    "%@ ran into an error" : {
      "comment" : "The placeholder is the name of a command."
    },
    "%@ sign-in" : {
      "comment" : "The placeholder is a service, such as GitHub."
    },
    "%@ stopped" : {
      "comment" : "The placeholder is the name of a command."
    },
    "%@ takes no command from Floe, so the connection opened in %@" : {
      "comment" : "Both placeholders are names of terminal apps.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ takes no command from Floe, so the connection opened in %2$@"
          }
        }
      }
    },
    "%@ to %@ · %@" : {
      "comment" : "The first two placeholders are the times an event starts and ends, and the third is the name of a calendar.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ to %2$@ · %3$@"
          }
        }
      }
    },
    "%@ was changed after Floe wrote it, so it stays where it is" : {
      "comment" : "The placeholder is the name of a note's file."
    },
    "%@ was not found on your PATH." : {
      "comment" : "The placeholder is the name of a command, and PATH is the shell variable and stays as written."
    },
    "%@ · %@" : {
      "comment" : "Beside a reminder that goes to a list the user named. The first placeholder is when it is due, the second is the list.\nThe track that is playing. The first placeholder is its name, the second is the artist.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ · %2$@"
          }
        }
      },
      "shouldTranslate" : false
    },
    "%@ · can be deleted" : {
      "comment" : "Beside the receipt of something Floe added. The placeholder is a time, such as 2 hr. ago."
    },
    "%@ · can be moved to the Trash" : {
      "comment" : "Beside the receipt of a note Floe wrote. The placeholder is a time, such as 2 hr. ago."
    },
    "%@ · can be put back" : {
      "comment" : "Beside a receipt. The placeholder is a time, such as 2 hr. ago."
    },
    "%@ · can be stopped" : {
      "comment" : "Beside the receipt of a timer Floe started. The placeholder is a time, such as 2 hr. ago."
    },
    "%@ · deleted" : {
      "comment" : "Beside the receipt of something Floe added that was deleted again. The placeholder is a time, such as 2 hr. ago."
    },
    "%@ · moved to the Trash" : {
      "comment" : "Beside the receipt of a note that was moved to the Trash again. The placeholder is a time, such as 2 hr. ago."
    },
    "%@ · put back" : {
      "comment" : "Beside a receipt. The placeholder is a time, such as 2 hr. ago."
    },
    "%@ · stopped" : {
      "comment" : "Beside the receipt of a timer that was stopped. The placeholder is a time, such as 2 hr. ago."
    },
    "%@, %@" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@, %2$@"
          }
        }
      },
      "shouldTranslate" : false
    },
    "%@, all day" : {
      "comment" : "Beside an event that fills a day. The placeholder is the day, such as Fri 9 Oct."
    },
    "%@, on this Mac" : {
      "comment" : "The placeholder is the address of a server such as localhost:8080."
    },
    "%@: %@" : {
      "comment" : "The first placeholder says what failed, the second is the reason.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@: %2$@"
          }
        }
      }
    },
    "%lld aliases, %lld hotkeys, %lld favorites, preferences for %lld extensions." : {
      "comment" : "What a settings file brought in. Each placeholder is a count.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$lld aliases, %2$lld hotkeys, %3$lld favorites, preferences for %4$lld extensions."
          }
        }
      }
    },
    "%lld characters" : {
      "comment" : "How long a copied text is.",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld character"
