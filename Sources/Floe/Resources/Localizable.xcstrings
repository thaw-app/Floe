                  "value" : "%lld commands"
                }
              }
            }
          }
        }
      }
    },
    "%lld entries in iCloud could not be read and were skipped." : {
      "comment" : "The placeholder is a count."
    },
    "%lld files" : {
      "comment" : "A count of files and folders in a checkpoint.\nHow many files were copied together.",
      "localizations" : {
