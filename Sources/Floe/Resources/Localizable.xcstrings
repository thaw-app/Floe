    ";sig" : {},
    "@raycast.argument%lld isn't valid JSON with a placeholder, e.g. {\"type\": \"text\", \"placeholder\": \"Name\"}." : {
      "comment" : "The word that starts with @raycast and the keys in the braces are typed into a script as they are, and the placeholder is the number of the argument."
    },
    "A command line tool is chosen, which sends questions to the service it is signed in to. While the switch below is on, Floe refuses to ask it, so no question is sent." : {},
    "A command line tool you are signed in to" : {},
    "A follow-up in Ask AI sends the earlier questions and answers of that conversation again, to the same place. Floe keeps them in memory until the answer view closes and saves none of it." : {
      "comment" : "Ask AI is the name of the feature that answers a question in the launcher."
    },
    "A source that sends questions elsewhere is refused, for Ask AI and for extensions. Nothing else is asked in its place." : {},
    "AI" : {
      "comment" : "The heading over the settings for artificial intelligence.\nThe kind of a result, shown beside its title. Short for artificial intelligence."
    },
    "AI can't answer yet. %@ is not installed. Install it and sign in, or choose another tool." : {
      "comment" : "The placeholder is the name of a command line tool such as claude."
    },
    "AI can't answer yet. Install claude, codex, opencode or pi and sign in." : {
      "comment" : "The names claude, codex, opencode and pi are commands and stay as written."
