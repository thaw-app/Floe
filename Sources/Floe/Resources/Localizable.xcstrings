{
  "sourceLanguage" : "en",
  "strings" : {
    "%@" : {
      "shouldTranslate" : false
    },
    "%@ (default)" : {
      "comment" : "A row in the Open With menu. The placeholder is the name of the app that opens this kind of file by default.\nThe placeholder is the name of a browser."
    },
    "%@ (not installed)" : {
      "comment" : "The placeholder is the name of a command line tool such as claude.\nThe placeholder is the name of an app."
    },
    "%@ can check for updates automatically. You can also check manually from the menu bar or Settings › About." : {
      "comment" : "The placeholder is the name of this app."
    },
    "%@ couldn’t load the release notes." : {
      "comment" : "The placeholder is the name of this app."
    },
    "%@ failed" : {
      "comment" : "The placeholder is the name of a command."
    },
    "%@ failed. Open it in Shortcuts to see why." : {
      "comment" : "The placeholder is the name of a shortcut, and Shortcuts is the app."
    },
    "%@ failed: %@" : {
      "comment" : "The first placeholder is the name of a script, the second is the reason.\nThe first placeholder is the name of a shortcut and the second is what the Shortcuts tool said.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ failed: %2$@"
          }
        }
      }
    },
    "%@ is a launcher for your apps and commands. It runs Raycast extensions and searches your menu bar." : {
      "comment" : "The placeholder is the name of this app."
    },
    "%@ is a sibling of Thaw, built by the same people in the same organization. It shares Thaw’s design system and much of its design." : {
      "comment" : "The placeholder is the name of this app."
    },
    "%@ is chosen, which is not on this Mac. While the switch below is on, Floe refuses to ask it, so no question is sent." : {
      "comment" : "The placeholder is the address of a server."
    },
    "%@ isn't installed" : {
      "comment" : "The placeholder is the name of an app."
    },
    "%@ isn't installed. Opened in %@" : {
      "comment" : "Both placeholders are names of browsers.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ isn't installed. Opened in %2$@"
          }
        }
      }
    },
    "%@ isn't installed. Opened in the default browser" : {
      "comment" : "The placeholder is the name of a browser."
    },
    "%@ isn't responding" : {
      "comment" : "The placeholder is the name of a command."
    },
    "%@ isn't supported yet" : {
      "comment" : "The placeholder is the name of a kind of view, such as Grid."
    },
    "%@ needs these before it can run. Change them later in Floe Settings." : {
      "comment" : "The placeholder is the name of an extension or one of its commands."
    },
    "%@ ran into an error" : {
      "comment" : "The placeholder is the name of a command."
    },
    "%@ stopped" : {
      "comment" : "The placeholder is the name of a command."
    },
    "%@ takes no command from Floe, so the connection opened in %@" : {
      "comment" : "Both placeholders are names of terminal apps.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ takes no command from Floe, so the connection opened in %2$@"
          }
        }
      }
    },
    "%@ to %@ · %@" : {
      "comment" : "The first two placeholders are the times an event starts and ends, and the third is the name of a calendar.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ to %2$@ · %3$@"
          }
        }
      }
    },
    "%@ was not found on your PATH." : {
      "comment" : "The placeholder is the name of a command, and PATH is the shell variable and stays as written."
    },
    "%@ · %@" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ · %2$@"
          }
        }
      },
      "shouldTranslate" : false
    },
    "%@, %@" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@, %2$@"
          }
        }
      },
      "shouldTranslate" : false
    },
    "%@, on this Mac" : {
      "comment" : "The placeholder is the address of a server such as localhost:8080."
    },
    "%@: %@" : {
      "comment" : "The first placeholder says what failed, the second is the reason.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@: %2$@"
          }
        }
      }
    },
    "%lld aliases, %lld hotkeys, %lld favorites, preferences for %lld extensions." : {
      "comment" : "What a settings file brought in. Each placeholder is a count.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$lld aliases, %2$lld hotkeys, %3$lld favorites, preferences for %4$lld extensions."
          }
        }
      }
    },
    "%lld characters" : {
      "comment" : "How long a copied text is.",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld character"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld characters"
                }
              }
            }
          }
        }
      }
    },
    "%lld commands" : {
      "comment" : "The placeholder is how many commands an extension has.",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld command"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld commands"
                }
              }
            }
          }
        }
      }
    },
    "%lld files" : {
      "comment" : "How many files were copied together.",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld file"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld files"
                }
              }
            }
          }
        }
      }
    },
    "%lld items" : {
      "comment" : "How many lines a list has.",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld item"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld items"
                }
              }
            }
          }
        }
      }
    },
    "%lld of %lld" : {
      "comment" : "How many lines of a list match what was typed: 3 of 40.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$lld of %2$lld"
          }
        }
      }
    },
    "%lld results" : {
      "comment" : "The placeholder is how many settings a search found.",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld result"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld results"
                }
              }
            }
          }
        }
      }
    },
    "(no output)" : {
      "comment" : "Shown in place of what a script printed when it printed nothing."
    },
