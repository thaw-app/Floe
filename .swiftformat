# This file is configured to match the project's SwiftLint rules.

# Never format build output, the generated project, or vendored packages.
--exclude .build
--exclude build
--exclude Vendor
--exclude Floe.xcodeproj

# --swift-version: Specify Swift version to enable all formatting features.
--swift-version 6.0

# --indent 4: Matches 'prefer_spaces_over_tabs' custom rule.
--indent 4
--tab-width 4
--smart-tabs disabled

# --max-width 0: Disables line-length wrapping, as 'line_length' is disabled in SwiftLint.
--max-width 0

# --trailing-commas always: Matches 'trailing_comma: mandatory_comma: true'.
--trailing-commas always

# --header ignore: files ported from Thaw carry Thaw's copyright line and Floe's,
# while Floe's own files carry one. A single literal header here would overwrite
# the ported ones, so header text is left alone and SwiftLint checks it.
--header ignore

# --enable isEmpty: Opt-in rule to match SwiftLint's 'empty_count'.
--enable isEmpty

# These rules are too aggressive or cause conflicts and need to be disabled.
--disable redundantEquatable
--disable redundantSelf
--disable redundantReturn

# Keep wrapping as written. "disabled" would join every wrapped list onto one line.
--wrap-arguments preserve
--wrap-collections preserve
--wrap-conditions preserve


# General formatting rules for consistency and modern Swift style

# --self remove: Use implicit self, as is common practice.
--self remove

# --allman false: Use K&R style braces (opening brace on the same line).
--allman false

# --semicolons inline-only: Remove unnecessary semicolons.
--semicolons inline-only

# --disable redundantRawValues: raw values that are persisted or sent to the
# extension host are a stored format, not a spelling, so a "redundant" one stays.
--disable redundantRawValues

# Newer rules that would merge guards, wrap one-line bodies, turn // into /// or change
# test signatures. SwiftLint's modifier_order already checks modifier order.
--disable repeatedGuard,wrapIfStatementBodies,wrapIfExpressionBodies,wrapPropertyBodies,wrapFunctionBodies,wrapLoopBodies
--disable docComments,redundantThrows,redundantAsync,hoistTry,hoistAwait,unusedArguments
--disable modifierOrder,extensionAttributes,noForceUnwrapInTests,swiftTestingTestCaseNames
